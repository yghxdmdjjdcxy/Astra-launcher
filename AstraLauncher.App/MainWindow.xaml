<Window x:Class="AstraLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AstraLauncher.App.ViewModels"
        Title="Astra Launcher" Height="560" Width="960" MinHeight="480" MinWidth="760">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:WelcomePageViewModel}"><StackPanel><TextBlock FontSize="28" Text="欢迎使用 Astra Launcher"/><TextBlock Margin="0,12,0,0" Text="基础架构已就绪。游戏版本、下载和认证将在后续已验证阶段提供。" TextWrapping="Wrap"/></StackPanel></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstancesPageViewModel}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel><TextBlock FontSize="24" Text="游戏实例"/><TextBlock Margin="0,6,0,10" Text="创建的实例使用独立目录；导入目录只登记，删除时不会修改原文件。启动前会自动下载并校验所需游戏文件。" TextWrapping="Wrap"/>
                    <WrapPanel><TextBlock Margin="0,0,6,8" VerticalAlignment="Center" Text="名称"/><TextBox Width="160" Margin="0,0,8,8" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Margin="0,0,6,8" VerticalAlignment="Center" Text="版本"/><ComboBox Width="150" Margin="0,0,8,8" IsEditable="True" ItemsSource="{Binding AvailableVersions}" Text="{Binding VersionId, UpdateSourceTrigger=PropertyChanged}" ToolTip="从版本列表选择，或直接输入版本号"/><Button Content="创建" Command="{Binding CreateCommand}" Margin="0,0,8,8"/><Button Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,8,8"/><Button Content="重命名" Command="{Binding RenameCommand}" Margin="0,0,8,8"/><Button Content="复制" Command="{Binding DuplicateCommand}" Margin="0,0,8,8"/><Button Content="删除" Command="{Binding DeleteCommand}" Margin="0,0,8,8"/></WrapPanel>
                    <WrapPanel><TextBlock Margin="0,0,6,8" VerticalAlignment="Center" Text="导入路径"/><TextBox Width="360" Margin="0,0,8,8" Text="{Binding ImportPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="要导入的现有游戏目录"/><Button Content="导入目录" Command="{Binding ImportCommand}" Margin="0,0,8,8"/><Button Content="检测 Java" Command="{Binding DetectJavaCommand}" Margin="0,0,8,8"/><Button Content="结束游戏" Command="{Binding StopCommand}"/></WrapPanel>
                    <WrapPanel Margin="0,0,0,4"><Button Content="启动游戏" Command="{Binding LaunchCommand}" Margin="0,0,8,8" FontWeight="SemiBold"/><ProgressBar Width="240" Height="16" Minimum="0" Maximum="100" Value="{Binding LaunchPercent, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock VerticalAlignment="Center" Text="{Binding LaunchStage}" TextTrimming="CharacterEllipsis"/></WrapPanel>
                </StackPanel>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Margin="0,8,8,4" FontWeight="SemiBold" Text="实例列表"/>
                    <TextBlock Grid.Column="1" Margin="8,8,8,4" FontWeight="SemiBold" Text="Java 运行时"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" DisplayMemberPath="Name" Margin="0,0,8,8"/>
                    <ListBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding JavaRuntimes}" Margin="8" DisplayMemberPath="ExecutablePath"/>
                </Grid>
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="游戏日志"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding GameLogs}" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"/>
                </Grid>
                <TextBlock Grid.Row="3" Margin="0,6,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DownloadsPageViewModel}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock FontSize="24" Text="下载"/>
                    <TextBlock Margin="0,6,0,12" Text="选择 Minecraft 版本并下载客户端、依赖库与资源文件；下载源可在设置中切换（官方源 / 镜像 / 自动回退）。" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <Button Content="刷新版本列表" Command="{Binding RefreshVersionsCommand}" Margin="0,0,8,8"/>
                        <Button Content="下载所选版本" Command="{Binding InstallCommand}" Margin="0,0,8,8"/>
                        <Button Content="取消下载" Command="{Binding CancelCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" DisplayMemberPath="Id" Margin="0,8,8,8"/>
                <StackPanel Grid.Row="2">
                    <ProgressBar Height="18" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"/>
                    <TextBlock Margin="0,4,0,0" Text="{Binding ProgressText}" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Grid.Row="3" Margin="0,8,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountsPageViewModel}">
            <Grid>
                <Grid.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibility"/></Grid.Resources>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock FontSize="24" Text="账户"/>
                    <TextBlock Margin="0,6,0,10" Text="官方 Microsoft 登录需要 Azure 应用注册的公共客户端 ID；离线档案无需登录，仅用于单机游戏。" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock FontWeight="SemiBold" Text="Microsoft 登录"/>
                    <TextBlock Margin="0,4,0,8" Foreground="#475569" Text="登录时会显示设备码，请在浏览器中打开指定地址并输入代码完成授权；授权成功后账户会出现在下方列表。" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <TextBlock Margin="0,0,6,8" VerticalAlignment="Center" Text="Client ID"/>
                        <TextBox Width="360" Margin="0,0,8,8" Text="{Binding MicrosoftClientId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Azure 门户 → 应用注册 → 公共客户端（移动和桌面应用）→ 应用程序(客户端) ID"/>
                        <Button Content="添加 Microsoft 账户" Command="{Binding AddMicrosoftCommand}" Margin="0,0,8,8" Padding="14,4"/>
                        <Button Content="取消" Command="{Binding CancelMicrosoftCommand}" Margin="0,0,8,8" Padding="14,4" Visibility="{Binding HasPendingDeviceCode, Converter={StaticResource BooleanToVisibility}}"/>
                    </WrapPanel>
                    <Border Margin="0,4,0,8" Padding="10" Background="#F1F5F9" CornerRadius="4" Visibility="{Binding HasPendingDeviceCode, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap"><Run Text="在浏览器打开 "/><Run FontWeight="SemiBold" Text="{Binding DeviceCodeVerificationUri, Mode=OneWay}"/></TextBlock>
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"><Run Text="输入代码："/><Run FontSize="18" FontWeight="Bold" Text="{Binding DeviceCodeUserCode, Mode=OneWay}"/></TextBlock>
                            <TextBlock Margin="0,4,0,0" Text="{Binding DeviceCodeMessage, Mode=OneWay}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#64748B" Text="{Binding DeviceCodeExpiresAtText, Mode=OneWay}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock FontWeight="SemiBold" Text="离线档案"/>
                    <TextBlock Margin="0,4,0,8" Foreground="#475569" Text="离线档案不会连接 Microsoft 服务；玩家名长度为 1–16 个字符。" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <TextBlock Margin="0,0,6,8" VerticalAlignment="Center" Text="玩家名"/>
                        <TextBox Width="200" Margin="0,0,8,8" MaxLength="16" Text="{Binding AddOfflineName, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="添加离线档案" Command="{Binding AddOfflineCommand}" Margin="0,0,8,8" Padding="14,4"/>
                    </WrapPanel>
                </StackPanel>
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="删除账户" Command="{Binding RemoveAccountCommand}" Margin="8,0,0,0" Padding="14,2"/>
                            <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0" Padding="14,2"/>
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="账户列表"/>
                    </DockPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding PlayerName}"/>
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#475569">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="离线档案"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMicrosoft}" Value="True">
                                                            <Setter Property="Text" Value="官方 Microsoft"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Xuid, StringFormat='XUID：{0}   '}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMicrosoft}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding PlayerUuid, StringFormat='UUID：{0}'}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <TextBlock Grid.Row="3" Margin="0,8,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServersPageViewModel}"><StackPanel><TextBlock FontSize="24" Text="服务器"/><TextBlock Margin="0,12,0,0" Text="Stage 7：服务器与联机基础设施。"/></StackPanel></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock FontSize="24" Text="设置"/>
                    <TextBlock Margin="0,6,0,10" Text="调整 Minecraft 目录、启动内存、下载源和 Java 运行时。修改仅在点击“保存设置”后写入；Minecraft 目录保存后立即生效。" TextWrapping="Wrap"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="性能与下载"/>
                        <Grid Margin="0,6,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Margin="0,0,12,8" VerticalAlignment="Center" Text="内存 MiB"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Width="160" Margin="0,0,0,8" HorizontalAlignment="Left" Text="{Binding MemoryMiB, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Margin="0,0,12,8" VerticalAlignment="Center" Text="并发下载"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Width="160" Margin="0,0,0,8" HorizontalAlignment="Left" Text="{Binding MaxConcurrentDownloads, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="2" Margin="0,0,12,8" VerticalAlignment="Center" Text="下载源"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Width="220" Margin="0,0,0,8" HorizontalAlignment="Left" ItemsSource="{Binding AvailableSourceModes}" SelectedItem="{Binding SourceMode}"/>
                            <TextBlock Grid.Row="3" Margin="0,0,12,0" VerticalAlignment="Center" Text="镜像地址"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MirrorBaseUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="镜像不可用时回退到官方源；留空将恢复默认镜像地址。"/>
                        </Grid>
                        <TextBlock FontWeight="SemiBold" Text="Minecraft 目录"/>
                        <TextBlock Margin="0,4,0,8" Text="versions / libraries / assets 的存放位置。默认使用 exe 旁边的 .minecraft（其次 %APPDATA%\.minecraft）；可与其他启动器共用，目录中已有文件会被直接复用，缺失文件才下载。" TextWrapping="Wrap"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="目录路径"/>
                            <TextBox Grid.Column="1" Text="{Binding MinecraftDirectory, UpdateSourceTrigger=PropertyChanged}" ToolTip="留空将使用默认目录；保存后立即生效（新版本安装与启动都会使用该目录）。"/>
                            <Button Grid.Column="2" Content="浏览…" Command="{Binding BrowseMinecraftDirectoryCommand}" Margin="8,0,0,0" Padding="12,2"/>
                        </Grid>
                        <TextBlock FontWeight="SemiBold" Text="Java 运行时"/>
                        <Grid Margin="0,6,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="选择 Java"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding JavaOptions}" SelectedItem="{Binding SelectedJavaChoice}" DisplayMemberPath="Display" ToolTip="“自动选择”会按游戏版本要求匹配已检测的 Java。"/>
                        </Grid>
                        <TextBlock FontWeight="SemiBold" Text="游戏与账户"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Margin="0,0,12,8" VerticalAlignment="Center" Text="离线玩家名"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Width="200" Margin="0,0,0,8" HorizontalAlignment="Left" MaxLength="16" Text="{Binding OfflinePlayerName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Margin="0,0,12,8" VerticalAlignment="Center" Text="显示快照"/>
                            <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" VerticalAlignment="Center" Content="在版本列表中显示快照版本" IsChecked="{Binding ShowSnapshots}"/>
                            <TextBlock Grid.Row="2" Margin="0,0,12,8" VerticalAlignment="Center" Text="额外 JVM 参数"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding JvmArguments, UpdateSourceTrigger=PropertyChanged}" ToolTip="附加到 Java 命令行，例如 -XX:+UseG1GC。"/>
                            <TextBlock Grid.Row="3" Margin="0,0,12,0" VerticalAlignment="Center" Text="额外游戏参数"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding GameArguments, UpdateSourceTrigger=PropertyChanged}" ToolTip="附加到游戏参数，例如 --demo。"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <WrapPanel>
                        <Button Content="保存设置" Command="{Binding SaveCommand}" Margin="0,0,8,8" Padding="14,4" FontWeight="SemiBold"/>
                        <Button Content="重新检测 Java" Command="{Binding RefreshJavaCommand}" Margin="0,0,8,8" Padding="14,4"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Left" Width="180" Background="#1E293B" Padding="12"><StackPanel><TextBlock Foreground="White" FontSize="20" FontWeight="SemiBold" Text="ASTRA" Margin="0,0,0,20"/><Button Content="首页" Command="{Binding NavigateCommand}" CommandParameter="Welcome" Margin="0,0,0,8"/><Button Content="游戏实例" Command="{Binding NavigateCommand}" CommandParameter="Instances" Margin="0,0,0,8"/><Button Content="下载" Command="{Binding NavigateCommand}" CommandParameter="Downloads" Margin="0,0,0,8"/><Button Content="账户" Command="{Binding NavigateCommand}" CommandParameter="Accounts" Margin="0,0,0,8"/><Button Content="服务器" Command="{Binding NavigateCommand}" CommandParameter="Servers" Margin="0,0,0,8"/><Button Content="设置" Command="{Binding NavigateCommand}" CommandParameter="Settings"/></StackPanel></Border>
        <Grid Margin="28"><ContentControl Content="{Binding Navigation.CurrentPage}"/></Grid>
    </DockPanel>
</Window>
