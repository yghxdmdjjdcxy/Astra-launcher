<Window x:Class="AstraLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AstraLauncher.App.ViewModels"
        xmlns:core="clr-namespace:AstraLauncher.Core.Models;assembly=AstraLauncher.Core"
        Title="Astra Launcher · 内测版本" Height="780" Width="1220" MinHeight="660" MinWidth="1000">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>

        <!-- Shared typography / layout -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,8"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E40AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="NavSection" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="4,14,0,6"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ListItemTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style x:Key="ListItemMeta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ============================ Welcome / Home ============================ -->
        <DataTemplate DataType="{x:Type vm:WelcomePageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="欢迎使用 Astra Launcher"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="开箱即用的 Minecraft Java 版启动器：下载版本 → 创建实例 → 启动游戏。启动前会自动校验并补齐游戏文件；离线档案无需登录即可游玩。"/>

                    <UniformGrid Columns="3" Margin="0,0,0,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,12">
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="#2563EB" Text="① 下载游戏版本"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,10"
                                           Text="在「下载」里选择正式版本并下载客户端、依赖库和资源文件。支持官方源 / BMCLAPI 镜像自动回退与多线程下载。"/>
                                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                        Content="去下载版本"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="Downloads"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="5,0,5,12">
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="#2563EB" Text="② 创建游戏实例"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,10"
                                           Text="每个实例使用独立目录，互不影响；可以导入已有游戏目录，删除实例不会修改原文件。"/>
                                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                        Content="创建游戏实例"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="Instances"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="10,0,0,12">
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="#2563EB" Text="③ 启动游戏"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,10"
                                           Text="选中实例后点「启动游戏」。启动器会检查 Java、校验文件并在实例页显示游戏日志与退出码。"/>
                                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                        Content="去启动游戏"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="Instances"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="当前状态"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource Hint}" Text="Minecraft 目录"/>
                                    <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="#0F172A"
                                               Text="{Binding DataContext.MinecraftDirectory, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                               Text="版本/库/资源在 .minecraft（可与其他启动器共用）；设置、账户、日志、实例存档在 .minecraft\AstraLauncher。可在「设置」中查看或修改。"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource Hint}" Text="账户"/>
                                    <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="#0F172A"
                                               Text="{Binding DataContext.AccountSummary, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource Hint}" Text="Java 运行时"/>
                                    <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="#0F172A"
                                               Text="{Binding DataContext.JavaSummary, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Style="{StaticResource Hint}" Text="版本列表"/>
                                    <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="#0F172A"
                                               Text="{Binding DataContext.VersionSummary, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="小提示"/>
                            <TextBlock Style="{StaticResource Hint}" Text="• 第一次使用建议先下载 1.21.1（约 877 MiB，多线程下载约 10 分钟）。"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="• 没有正版账号时可直接在「账户」添加离线档案；官方 Microsoft 登录需要 Azure 公共客户端 ID。"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="• 下载失败时：在「设置」切换到其他下载源（官方 / BMCLAPI / 自动回退）后重试；已下载文件会复用。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- ============================ Instances ============================ -->
        <DataTemplate DataType="{x:Type vm:InstancesPageViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="游戏实例"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="实例使用独立目录，互不干扰；导入目录只登记、删除时不会修改原文件。启动前会自动校验并补齐游戏文件。"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="新建 / 导入实例"/>
                        <WrapPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="名称"/>
                            <TextBox Width="170" Margin="0,0,16,8" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="实例显示名称"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="版本"/>
                            <ComboBox Width="180" Margin="0,0,16,8" IsEditable="True"
                                      ItemsSource="{Binding AvailableVersions}" Text="{Binding VersionId, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="从列表选择，或直接输入版本号"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="创建" Command="{Binding CreateCommand}" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="导入路径"/>
                            <TextBox Width="420" Margin="0,0,8,0" Text="{Binding ImportPath, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="现有游戏目录的绝对路径（只登记，不移动文件）"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="导入目录" Command="{Binding ImportCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="扫描其他启动器" Command="{Binding ScanExternalCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="导入全局存档" Command="{Binding ImportSavesCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="检测 Java" Command="{Binding DetectJavaCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButton}" Content="刷新" Command="{Binding RefreshCommand}" Margin="6,0,0,0"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="重命名" Command="{Binding RenameCommand}" Margin="6,0,0,0"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="复制" Command="{Binding DuplicateCommand}" Margin="6,0,0,0"/>
                                    <Button Style="{StaticResource DangerButton}" Content="删除" Command="{Binding DeleteCommand}" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Text="实例列表"/>
                            </DockPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,4">
                                            <TextBlock Style="{StaticResource ListItemTitle}" Text="{Binding Name}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Style="{StaticResource ListItemMeta}" Text="{Binding VersionId, StringFormat='版本：{0}   '}"/>
                                                <TextBlock Style="{StaticResource ListItemMeta}" Text="{Binding DirectoryPath}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Java 运行时"/>
                                <TextBlock Style="{StaticResource Hint}" Text="启动时自动选择匹配版本；也可在「设置」固定选择。"/>
                            </StackPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding JavaRuntimes}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,3">
                                            <TextBlock Style="{StaticResource ListItemTitle}">
                                                <Run Text="Java "/><Run Text="{Binding MajorVersion}"/><Run Text=" · "/><Run Text="{Binding Version}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource ListItemMeta}" Text="{Binding ExecutablePath}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Hint}" Text="当前选中实例"/>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#0F172A">
                                <Run Text="{Binding SelectedInstance.Name, Mode=OneWay, TargetNullValue='未选择实例（请在左侧列表选择）'}"/>
                                <Run Text="{Binding SelectedInstance.VersionId, Mode=OneWay, StringFormat='（版本 {0}）'}"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="启动游戏" Command="{Binding LaunchCommand}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="补全游戏文件" Command="{Binding RepairFilesCommand}" Margin="0,0,8,0"
                                        ToolTip="校验客户端、依赖库与资源文件，缺失或损坏时自动下载补全"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="结束游戏" Command="{Binding StopCommand}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,0">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding LaunchPercent, Mode=OneWay}"/>
                            <TextBlock Margin="0,6,0,0" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                        <Setter Property="Text" Value="{Binding LaunchStage}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LaunchStage}" Value="">
                                                <Setter Property="Text" Value="准备就绪。选择实例后点击「启动游戏」；启动前会自动校验并补齐游戏文件。"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="游戏日志"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center" Text="最新在上，最多 500 行"/>
                        </StackPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding GameLogs}" FontFamily="Consolas" FontSize="11" Margin="0,2,0,0"/>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="5" Style="{StaticResource Hint}" Text="{Binding StatusMessage}"/>
            </Grid>
        </DataTemplate>

        <!-- ============================ Downloads ============================ -->
        <DataTemplate DataType="{x:Type vm:DownloadsPageViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="下载"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="选择 Minecraft 版本并下载客户端、依赖库和资源文件。下载源可在「设置」切换：官方源 / BMCLAPI 镜像 / 自动回退。"/> 
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <WrapPanel>
                            <Button Style="{StaticResource SecondaryButton}" Content="刷新版本列表" Command="{Binding RefreshVersionsCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="下载所选版本" Command="{Binding InstallCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="取消下载" Command="{Binding CancelCommand}"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="大文件自动使用多线程分段下载；已存在且校验通过的文件会直接复用。"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="可选版本（正式版）"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,-4,0,8" Text="选中一个版本，再点「下载所选版本」。"/>
                        </StackPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,3">
                                        <TextBlock Style="{StaticResource ListItemTitle}" Width="110" Text="{Binding Id}"/>
                                        <TextBlock Style="{StaticResource ListItemMeta}" Margin="8,0,0,0" Text="{Binding ReleaseTime, StringFormat='发布于 {0:yyyy-MM-dd}'}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <Border Grid.Row="3" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="安装模组加载器（可选）"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,-4,0,8"
                                   Text="先在上方选择 Minecraft 版本，再选择加载器并安装；安装完成后可在「游戏实例」的版本列表中选择该加载器版本启动。"/>
                        <WrapPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="加载器"/>
                            <ComboBox Width="140" Margin="0,0,12,8" ItemsSource="{Binding LoaderKinds}" SelectedItem="{Binding SelectedLoaderKind}" DisplayMemberPath="Display"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="加载器版本"/>
                            <ComboBox Width="280" Margin="0,0,12,8" ItemsSource="{Binding LoaderVersions}" SelectedItem="{Binding SelectedLoaderVersion}" DisplayMemberPath="DisplayName"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="刷新加载器版本" Command="{Binding RefreshLoaderVersionsCommand}" Margin="0,0,8,8"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="安装加载器" Command="{Binding InstallLoaderCommand}" Margin="0,0,8,8"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="取消安装" Command="{Binding CancelLoaderCommand}" Margin="0,0,0,8"
                                    Visibility="{Binding IsLoaderBusy, Converter={StaticResource BooleanToVisibility}}"/>
                        </WrapPanel>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding LoaderProgressPercent, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{Binding LoaderProgressText}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding LoaderStatus}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="#0F172A"
                                   Text="{Binding SelectedVersion.Id, StringFormat='已选版本：{0}'}"/>
                        <ProgressBar Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{Binding ProgressText}"/>
                    </StackPanel>
                </Border>
                <TextBlock Grid.Row="5" Style="{StaticResource Hint}" Text="{Binding StatusMessage}"/>
            </Grid>
        </DataTemplate>

        <!-- ============================ Accounts ============================ -->
        <DataTemplate DataType="{x:Type vm:AccountsPageViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="账户"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="选择启动游戏使用的账户。离线档案无需登录即可游玩；官方 Microsoft 登录需要 Azure 应用注册的公共客户端 ID。"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="① 官方 Microsoft 登录（Xbox 弹窗）"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="点击「微软 / Xbox 弹窗登录」会打开微软官方登录窗口，登录完成后自动关闭并添加账户；无需填写 Client ID。设备码登录是备用方式。"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Style="{StaticResource PrimaryButton}" Content="微软 / Xbox 弹窗登录" Command="{Binding AddMicrosoftWebCommand}"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Client ID（设备码备用）" Margin="16,0,8,0" VerticalAlignment="Center"/>
                                <TextBox Width="240" Text="{Binding MicrosoftClientId, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="仅设备码登录需要：Azure 门户 → 应用注册 → 应用程序(客户端) ID"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="设备码登录" Command="{Binding AddMicrosoftCommand}" Margin="8,0,0,0"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="取消" Command="{Binding CancelMicrosoftCommand}" Margin="8,0,0,0"
                                        Visibility="{Binding HasPendingDeviceCode, Converter={StaticResource BooleanToVisibility}}"/>
                            </StackPanel>
                            <Border Margin="0,4,0,0" Padding="10" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4"
                                    Visibility="{Binding HasPendingDeviceCode, Converter={StaticResource BooleanToVisibility}}">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap"><Run Text="在浏览器打开 "/><Run FontWeight="SemiBold" Text="{Binding DeviceCodeVerificationUri, Mode=OneWay}"/></TextBlock>
                                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"><Run Text="输入代码："/><Run FontSize="20" FontWeight="Bold" Text="{Binding DeviceCodeUserCode, Mode=OneWay}"/></TextBlock>
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Hint}" Text="{Binding DeviceCodeMessage, Mode=OneWay}"/>
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Hint}" Text="{Binding DeviceCodeExpiresAtText, Mode=OneWay}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="② 离线档案"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="不连接 Microsoft 服务，适合单机/离线。玩家名 1–16 个字符；UUID 与其他启动器一致。"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="玩家名"/>
                                <TextBox Width="180" Margin="0,0,8,0" MaxLength="16" Text="{Binding AddOfflineName, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="添加离线档案" Command="{Binding AddOfflineCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource DangerButton}" Content="删除账户" Command="{Binding RemoveAccountCommand}" Margin="6,0,0,0"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="刷新" Command="{Binding RefreshCommand}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="③ 账户列表"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,-4,0,0" Text="选中的账户将用于启动游戏。"/>
                            </StackPanel>
                        </DockPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource ListItemTitle}" VerticalAlignment="Center" Text="{Binding PlayerName}"/>
                                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#475569">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="离线档案"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMicrosoft}" Value="True">
                                                                <Setter Property="Text" Value="官方 Microsoft"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Xuid, StringFormat='XUID：{0}   '}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMicrosoft}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource ListItemMeta}" Text="{Binding PlayerUuid, StringFormat='UUID：{0}'}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="3" Style="{StaticResource Hint}" Text="{Binding StatusMessage}"/>
            </Grid>
        </DataTemplate>

        <!-- ============================ Mods ============================ -->
        <DataTemplate DataType="{x:Type vm:ModsPageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="模组"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="管理所选实例 mods 目录中的本地 MOD，或按当前实例的 Minecraft 版本与加载器从 Modrinth 搜索并安装。"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="实例与已安装 MOD"/>
                            <Grid Margin="0,6,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="实例" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                                          DisplayMemberPath="Name" Margin="0,0,10,0"/>
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="刷新实例" Command="{Binding RefreshInstancesCommand}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Style="{StaticResource PrimaryButton}" Content="导入本地 MOD" Command="{Binding ImportCommand}"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="启用 / 禁用" Command="{Binding ToggleCommand}" Margin="8,0,0,0"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="打开 MOD 目录" Command="{Binding OpenFolderCommand}" Margin="8,0,0,0"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="刷新列表" Command="{Binding RefreshModsCommand}" Margin="8,0,0,0"/>
                                <Button Style="{StaticResource DangerButton}" Content="删除" Command="{Binding DeleteCommand}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}" Height="150"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,3">
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{Binding DisplayName, Mode=OneWay}"/>
                                                <Run Text="{Binding Version, Mode=OneWay}" Foreground="#64748B"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Hint}">
                                                <Run Text="{Binding Platform, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding ModId, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding IsEnabled, Mode=OneWay}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="从 Modrinth 搜索安装"/>
                            <Grid Margin="0,6,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入 MOD 名称或关键词"/>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="搜索" Command="{Binding SearchCommand}" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="游戏版本" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                <TextBox Grid.Column="3" Text="{Binding GameVersion, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                <ComboBox Grid.Column="4" ItemsSource="{Binding LoaderOptions}" SelectedItem="{Binding SelectedLoader}"
                                          DisplayMemberPath="Display" Margin="12,0,0,0"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}" Height="160"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,3">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="兼容版本" Style="{StaticResource Hint}"/>
                                    <ComboBox ItemsSource="{Binding ModVersions}" SelectedItem="{Binding SelectedModVersion}" DisplayMemberPath="VersionNumber" Margin="0,4,0,8"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="安装所选版本" Command="{Binding InstallCommand}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding SearchStatus}" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- ============================ Servers ============================ -->
        <DataTemplate DataType="{x:Type vm:ServersPageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="服务器"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="保存常用服务器；在「游戏实例」页选中实例后，回到这里点击「启动并加入」，启动参数会自动拼接 --server / --port。"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="服务器列表"/>
                            <TextBlock Style="{StaticResource Hint}" Text="地址可写成 host 或 host:port；端口留空时使用游戏默认端口。"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                <Button Style="{StaticResource SecondaryButton}" Content="刷新" Command="{Binding RefreshCommand}"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="新增服务器" Command="{Binding NewCommand}" Margin="8,0,0,0"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="启动并加入" Command="{Binding JoinCommand}" Margin="8,0,0,0"/>
                                <Button Style="{StaticResource DangerButton}" Content="删除" Command="{Binding DeleteCommand}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" MinHeight="120" MaxHeight="220"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DisplayAddress}" Style="{StaticResource Hint}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="添加 / 编辑服务器"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="名称" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,20,8"/>
                                <TextBlock Grid.Column="2" Text="端口" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                <TextBox Grid.Column="3" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Text="地址" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="保存服务器" Command="{Binding SaveCommand}"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="清空编辑" Command="{Binding NewCommand}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="说明"/>
                            <TextBlock Style="{StaticResource Hint}" Text="• 「启动并加入」使用「游戏实例」页当前选中的实例；没有选中实例时会提示先选择。"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="• 一键加入通过官方启动参数 --server / --port 实现，适用于原版与 Fabric/Quilt/Forge 等加载器版本。"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="• 服务器列表保存在启动器数据目录（servers.json），与 .minecraft 游戏文件分离。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- ============================ Settings ============================ -->
        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="设置"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="修改后点击底部「保存设置」。Minecraft 目录保存后立即生效；其他设置下次启动生效。"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Minecraft 目录"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                           Text="versions / libraries / assets 的存放位置。默认使用 exe 旁边的 .minecraft（其次 %APPDATA%\.minecraft）；可与其他启动器共用，已有文件会校验复用，缺失文件才下载。启动器自身的设置、账户、日志、实例存档也保存在该目录下的 AstraLauncher 子目录中。"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="游戏目录"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MinecraftDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding MinecraftDirectory}"
                                             ToolTipService.ShowDuration="30000"/>
                                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="浏览…" Command="{Binding BrowseMinecraftDirectoryCommand}" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="启动器数据"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" IsReadOnly="True" Background="#F8FAFC"
                                             Text="{Binding LauncherDataDirectory, Mode=OneWay}"
                                             ToolTip="{Binding LauncherDataDirectory, Mode=OneWay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="性能与下载"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="内存 MiB"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBox Width="140" Text="{Binding MemoryMiB, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center" Text="游戏 Java 堆内存，建议 4096。"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="并发下载"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBox Width="140" Text="{Binding MaxConcurrentDownloads, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center" Text="同时下载的文件数；网络较好可适当调高。"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="下载源"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                        <ComboBox Width="220" SelectedValue="{Binding SourceMode}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="官方源（Mojang）" Tag="{x:Static core:DownloadSourceMode.Official}"/>
                                    <ComboBoxItem Content="仅镜像（BMCLAPI）" Tag="{x:Static core:DownloadSourceMode.Mirror}"/>
                                    <ComboBoxItem Content="官方优先，失败自动回退镜像" Tag="{x:Static core:DownloadSourceMode.OfficialWithFallback}"/>
                                </ComboBox>
                                        <TextBlock Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center" Text="官方源为主时可镜像自动回退。"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="镜像地址"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="320" Text="{Binding MirrorBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="镜像不可用时回退到官方源；留空恢复默认镜像地址。"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center" Text="默认 BMCLAPI。"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Java 运行时"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="选择 Java"/>
                                    <ComboBox Width="520" ItemsSource="{Binding JavaOptions}" SelectedItem="{Binding SelectedJavaChoice}" DisplayMemberPath="Display"
                                              ToolTip="“自动选择”会按游戏版本要求匹配已检测的 Java。"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="重新检测 Java" Command="{Binding RefreshJavaCommand}" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="120,6,0,0" Text="启动时如果自动选择失败，可在这里手动指定。"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="一键安装 Java"/>
                                    <ComboBox Width="150" ItemsSource="{Binding JavaDownloads}"
                                              SelectedItem="{Binding SelectedJavaDownload}" DisplayMemberPath="Display"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="下载并安装"
                                            Command="{Binding DownloadJavaCommand}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="120,6,0,0"
                                           Text="从清华 TUNA / 中科大 Adoptium 镜像多线程下载 JDK 并解压，安装后自动设为当前 Java。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="游戏与参数"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="离线玩家名"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8" MaxLength="16"
                                             Text="{Binding OfflinePlayerName, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="未选择账户时使用的离线玩家名。"/>
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="显示快照"/>
                                    <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" VerticalAlignment="Center"
                                              Content="在版本列表中显示快照版本" IsChecked="{Binding ShowSnapshots}"/>
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="额外 JVM 参数"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding JvmArguments, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="附加到 Java 命令行，例如 -XX:+UseG1GC。"/>
                                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="额外游戏参数"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding GameArguments, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="附加到游戏参数，例如 --demo。"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="更新"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                           Text="从 GitHub Releases 检查新版本；下载完成后会自动替换当前 exe 并重启启动器。正在运行的游戏不受影响。"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="{Binding CurrentVersionText, StringFormat='当前版本：{0}'}"/>
                                <CheckBox Content="启动时自动检查更新" IsChecked="{Binding AutoCheckUpdates}" Margin="0,0,0,8"/>
                                <CheckBox Content="启动时显示内测提示" IsChecked="{Binding ShowBetaNotice}" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="立即检查更新" Command="{Binding CheckUpdateCommand}"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="保存设置" Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="重新检测 Java" Command="{Binding RefreshJavaCommand}"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{Binding StatusMessage}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolboxPageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="百宝箱"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="PCL 风格的小工具、自定义文件下载，以及启动器外观自定义。修改后立即生效并自动保存。"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="百宝箱"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="点一下试试。最后一个按钮真的建议别点。"/>
                            <UniformGrid Columns="4">
                                <Button Style="{StaticResource SecondaryButton}" Content="今日人品"
                                        Command="{Binding DailyLuckCommand}" Margin="0,0,10,0" Height="40"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="内存优化"
                                        Command="{Binding OptimizeMemoryCommand}" Margin="0,0,10,0" Height="40"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="清理游戏垃圾"
                                        Command="{Binding CleanJunkCommand}" Margin="0,0,10,0" Height="40"/>
                                <Button Style="{StaticResource DangerButton}" Content="千万别点"
                                        Command="{Binding DoNotClickCommand}" Height="40"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="听一句回声"
                                    Command="{Binding EchoCaveCommand}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="回声洞"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                           Text="灵感来自 PCL 的回声洞；这里显示的是 Astra Launcher 自己的留言。"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="下载自定义文件"/>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="使用启动器的高速下载引擎下载任意文件。请注意，部分网站（例如百度网盘）可能会报错 403，无法正常下载。"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="下载地址" Width="80"/>
                                <TextBox Width="600" Text="{Binding DownloadUrl, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="http / https 链接"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="保存到" Width="80"/>
                                <TextBox Width="520" Text="{Binding DownloadDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="选择" Margin="8,0,0,0"
                                        Command="{Binding BrowseDownloadFolderCommand}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="文件名" Width="80"/>
                                <TextBox Width="600" Text="{Binding DownloadFileName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="留空则使用链接中的文件名"/>
                            </StackPanel>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadProgress, Mode=OneWay}" Margin="0,12,0,0"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding DownloadStatus}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="开始下载"
                                        Command="{Binding StartDownloadCommand}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="打开文件夹"
                                        Command="{Binding OpenDownloadFolderCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="自定义 · 进度条样式"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="选择喜欢的样式后，所有页面的进度条会立即更新。"/>
                            <ListBox ItemsSource="{Binding ProgressBarPresets}"
                                     SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0,0,12,12"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="SelectionBorder" CornerRadius="12" BorderThickness="2"
                                                            BorderBrush="Transparent" Background="Transparent" Padding="2">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#2563EB"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="190" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                                CornerRadius="10" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}"
                                                           TextWrapping="Wrap" Margin="0,4,0,10" Height="34"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="16" Height="16" CornerRadius="4" Background="{Binding FillStart}"/>
                                                    <Border Width="16" Height="16" CornerRadius="4" Background="{Binding FillEnd}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="进度条粗细"/>
                                <ComboBox Width="150" ItemsSource="{Binding ProgressBarSizes}"
                                          SelectedItem="{Binding SelectedSize, Mode=TwoWay}"
                                          DisplayMemberPath="Label"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="恢复默认"
                                        Command="{Binding ResetCommand}" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,4" Text="效果预览（当前样式，68%）"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="68" Width="520" HorizontalAlignment="Left"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="{Binding StatusMessage}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="百宝箱 · 更多工具"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="后续版本会逐步开放，欢迎在 GitHub 提需求。"/>
                            <UniformGrid Columns="4">
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="10" Padding="16" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="🗂" FontSize="22"/>
                                        <TextBlock Text="存档管理" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="一键备份 / 还原世界存档"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="10" Padding="16" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="🎨" FontSize="22"/>
                                        <TextBlock Text="皮肤预览" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="查看与切换角色皮肤"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="10" Padding="16" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="⚡" FontSize="22"/>
                                        <TextBlock Text="一键优化" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="清理缓存与无效文件"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="10" Padding="16" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="🎵" FontSize="22"/>
                                        <TextBlock Text="音乐电台" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="启动游戏时播放背景音乐"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CloudDrivePageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="云盘"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="登录 Cloudreve 账号即可使用云盘：每个用户 4 个游戏版本槽位，上传自动压缩。登录/注册在本页完成，不需要打开 Cloudreve 网页；登录后会自动创建 WebDAV 账号。"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Cloudreve 账号（注册 / 登录）"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="输入 Cloudreve 站点地址、邮箱和密码。注册成功后自动登录，并自动创建 WebDAV 账号；不需要去 Cloudreve 网页操作。"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Cloudreve 地址"/>
                                <TextBox Grid.Column="1" Margin="0,0,0,8" Text="{Binding CloudreveServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="例如 https://cloud.astra-launcher-clouddrive.us.ci"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="邮箱"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding CloudreveEmail, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="密码"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding CloudrevePassword, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="仅用于本次登录，不写入磁盘"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Content="登录并连接" Command="{Binding CloudreveLoginCommand}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="注册新账号" Command="{Binding CloudreveRegisterCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="高级：手动 WebDAV 登录"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="WebDAV 地址"/>
                                <TextBox Grid.Column="1" Margin="0,0,0,8" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Cloudreve 默认：http://127.0.0.1:5212/dav/"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="账号"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="WebDAV 密码"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Cloudreve 账号密码或 WebDAV 专用密码，仅本次运行使用，不写入磁盘"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Content="连接" Command="{Binding ConnectCommand}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="刷新槽位" Command="{Binding RefreshCommand}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Width="470" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="{Binding RemoteInfo}" Margin="0,0,0,8"/>
                                        <ComboBox ItemsSource="{Binding DataContext.Instances, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  SelectedItem="{Binding SelectedInstance}" DisplayMemberPath="Name" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource PrimaryButton}" Content="上传到此槽位" Margin="0,0,8,0"
                                                    Command="{Binding DataContext.UploadSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource SecondaryButton}" Content="下载并恢复"
                                                    Command="{Binding DataContext.DownloadSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Background="#F1F5F9">
        <!-- Left navigation -->
        <Border DockPanel.Dock="Left" Width="210" Background="#0F172A" Padding="14,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Foreground="White" FontSize="22" FontWeight="Bold" Text="ASTRA"/>
                    <TextBlock Foreground="#94A3B8" FontSize="11" Margin="0,2,0,4" Text="Minecraft Java 启动器"/>
                    <TextBlock Style="{StaticResource NavSection}" Text="导航"/>
                    <Button Style="{StaticResource NavButton}" Content="首页" Command="{Binding NavigateCommand}" CommandParameter="Welcome"/>
                    <Button Style="{StaticResource NavButton}" Content="游戏实例" Command="{Binding NavigateCommand}" CommandParameter="Instances"/>
                    <Button Style="{StaticResource NavButton}" Content="下载" Command="{Binding NavigateCommand}" CommandParameter="Downloads"/>
                    <Button Style="{StaticResource NavButton}" Content="模组" Command="{Binding NavigateCommand}" CommandParameter="Mods"/>
                    <Button Style="{StaticResource NavButton}" Content="账户" Command="{Binding NavigateCommand}" CommandParameter="Accounts"/>
                    <Button Style="{StaticResource NavButton}" Content="服务器" Command="{Binding NavigateCommand}" CommandParameter="Servers"/>
                    <Button Style="{StaticResource NavButton}" Content="百宝箱" Command="{Binding NavigateCommand}" CommandParameter="Toolbox"/>
                    <Button Style="{StaticResource NavButton}" Content="云盘" Command="{Binding NavigateCommand}" CommandParameter="CloudDrive"/>
                    <TextBlock Style="{StaticResource NavSection}" Text="配置"/>
                    <Button Style="{StaticResource NavButton}" Content="设置" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Foreground="#64748B" FontSize="11" Margin="4,12,0,0" Text="{Binding AppVersion, StringFormat='{}{0} · 内测版本'}"/>
            </DockPanel>
        </Border>

        <!-- Header / content / footer -->
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,10">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="999" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Foreground="#92400E" FontSize="11" FontWeight="SemiBold" Text="内测版本"/>
                    </Border>
                    <TextBlock DockPanel.Dock="Right" Foreground="#475569" FontSize="12" VerticalAlignment="Center"
                               Text="{Binding AccountSummary, StringFormat='当前账户：{0}'}"/>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Text="Minecraft Java 版启动器"/>
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Text="{Binding AppVersion, StringFormat='{}{0} · 内测版本'}"/>
                    <TextBlock Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Text="{Binding FooterHint}"/>
                </DockPanel>
            </Border>
            <Grid Margin="24,16,24,16">
                <ContentControl Content="{Binding Navigation.CurrentPage}"/>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
