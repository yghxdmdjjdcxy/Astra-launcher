<Window x:Class="AstraLauncher.App.Services.BetaNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Astra Launcher 正式版"
        Width="560" Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0B0E14">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <Border HorizontalAlignment="Left" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1"
                    CornerRadius="999" Padding="10,3">
                <TextBlock Foreground="#92400E" FontSize="11" FontWeight="SemiBold" Text="正式版 · STABLE"/>
            </Border>
            <TextBlock Foreground="#EEF2FF" FontSize="26" FontWeight="Bold" Margin="0,14,0,6" Text="欢迎使用 Astra Launcher 1.0.9 正式版"/>
            <TextBlock x:Name="VersionText" Foreground="#94A3B8" FontSize="12" Text="版本 1.0.9"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,10">
            <StackPanel>
                <TextBlock Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap" LineHeight="24">
                    这是 Astra Launcher 的第一个正式版本（v1.0.9）。感谢参与测试和反馈的每一位玩家。本版包含：<LineBreak/>
                    <LineBreak/>• 重要存档与配置仍建议备份（实例目录下的 saves / config）<LineBreak/>
                    • 遇到问题可通过内置「问题反馈」或 GitHub Issues 提交<LineBreak/>
                    • 启动器会自动检查 GitHub Releases 更新<LineBreak/>
                    • 插件、联机和云盘仍会持续完善，完整 TUN 模式暂未开放<LineBreak/>
                    <LineBreak/>感谢使用 Astra Launcher。
                </TextBlock>
                <TextBlock Margin="0,16,0,0" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap">
                    项目主页：<Hyperlink NavigateUri="https://astra-launcher.us.ci" RequestNavigate="OnNavigate">https://astra-launcher.us.ci</Hyperlink>
                    <LineBreak/>问题反馈：<Hyperlink NavigateUri="https://github.com/yghxdmdjjdcxy/Astra-launcher/issues" RequestNavigate="OnNavigate">GitHub Issues</Hyperlink>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2">
            <CheckBox x:Name="DontShowAgainBox" Content="下次启动不再显示版本公告" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="更新日志" Width="100" Height="36" Margin="0,0,10,0" Click="OnOpenReleases"
                        Background="#1E293B" Foreground="#EEF2FF" BorderBrush="#334155"/>
                <Button Content="我知道了" Width="110" Height="36" Click="OnConfirm"
                        Background="#22D3A6" Foreground="#04110D" FontWeight="Bold" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
