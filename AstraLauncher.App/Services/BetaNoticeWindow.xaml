<Window x:Class="AstraLauncher.App.Services.BetaNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Astra Launcher 公开测试版"
        Width="560" Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0B0E14">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <Border HorizontalAlignment="Left" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1"
                    CornerRadius="999" Padding="10,3">
                <TextBlock Foreground="#92400E" FontSize="11" FontWeight="SemiBold" Text="公开测试 · BETA"/>
            </Border>
            <TextBlock Foreground="#EEF2FF" FontSize="26" FontWeight="Bold" Margin="0,14,0,6" Text="欢迎使用 Astra Launcher 公开测试版"/>
            <TextBlock x:Name="VersionText" Foreground="#94A3B8" FontSize="12" Text="版本 1.0.1"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,10">
            <StackPanel>
                <TextBlock Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap" LineHeight="24">
                    这是第二个公开测试版本（v1.0.8-beta），功能与稳定性仍在持续完善，可能遇到崩溃、下载失败或数据不兼容。建议：<LineBreak/>
                    <LineBreak/>• 重要存档与配置先备份（实例目录下的 saves / config）<LineBreak/>
                    • 遇到问题请附上 logs 目录日志到 GitHub Issues<LineBreak/>
                    • 启动器会自动检查 GitHub Releases 更新<LineBreak/>
                    • 云盘、自动更新、实例导入仍属于测试功能，接口可能调整<LineBreak/>
                    <LineBreak/>感谢参与公开测试，你的每条反馈都会帮助它变得更好。
                </TextBlock>
                <TextBlock Margin="0,16,0,0" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap">
                    项目主页：<Hyperlink NavigateUri="https://astra-launcher.us.ci" RequestNavigate="OnNavigate">https://astra-launcher.us.ci</Hyperlink>
                    <LineBreak/>问题反馈：<Hyperlink NavigateUri="https://github.com/yghxdmdjjdcxy/Astra-launcher/issues" RequestNavigate="OnNavigate">GitHub Issues</Hyperlink>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2">
            <CheckBox x:Name="DontShowAgainBox" Content="下次启动不再显示公开测试提示" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="更新日志" Width="100" Height="36" Margin="0,0,10,0" Click="OnOpenReleases"
                        Background="#1E293B" Foreground="#EEF2FF" BorderBrush="#334155"/>
                <Button Content="我知道了" Width="110" Height="36" Click="OnConfirm"
                        Background="#22D3A6" Foreground="#04110D" FontWeight="Bold" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
