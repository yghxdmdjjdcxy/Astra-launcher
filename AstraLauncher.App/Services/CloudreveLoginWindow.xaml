<Window x:Class="AstraLauncher.App.Services.CloudreveLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Astra Launcher &amp; Cloudrive 统一验证"
        Width="540" Height="760" MinWidth="460" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#0B0E14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#11161F" Padding="14,10">
            <TextBlock x:Name="HeaderText" Foreground="#C8D2E8" FontSize="12" TextWrapping="Wrap"
                       Text="在窗口中注册或登录 Cloudreve，成功后自动创建 WebDAV 账号并关闭窗口。"/>
        </Border>
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Browser"/>
            <Border x:Name="LoadingOverlay" Background="#0B0E14">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="280" Height="8"/>
                    <TextBlock x:Name="LoadingText" Margin="0,16,0,0" Foreground="#C8D2E8" FontSize="14"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Text="正在连接 Astra Launcher &amp; cloudrive 统一验证服务"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
