<Window x:Class="AstraLauncher.App.Services.MicrosoftLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="微软账户登录 - Astra Launcher"
        Width="520" Height="720" MinWidth="420" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#0B0E14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#11161F" Padding="14,10">
            <TextBlock x:Name="HintText" Foreground="#C8D2E8" FontSize="12" TextWrapping="Wrap"
                       Text="使用你的 Microsoft / Xbox 账户登录。登录成功后窗口会自动关闭，无需手动复制任何代码。"/>
        </Border>
        <wv2:WebView2 x:Name="Browser" Grid.Row="1"/>
    </Grid>
</Window>
