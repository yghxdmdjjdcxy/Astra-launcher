<Window x:Class="AstraLauncher.App.Services.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="问题反馈 · Astra Launcher"
        Width="700" Height="780"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="#0F172A" Text="问题反馈"/>
                <TextBlock FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="没有 GitHub 账号也能提交。反馈会生成 feedback.md；截图会无损压缩后嵌入 Markdown；勾选「提交日志」会一并上传启动器/游戏日志。"/>
            </StackPanel>

            <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="一句话摘要"/>
                    <TextBox x:Name="SummaryBox" Margin="0,6,0,12" MaxLength="120" ToolTip="例如：启动 1.20.1 Forge 实例时崩溃"/>
                    <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="详细描述 *"/>
                    <TextBox x:Name="DescriptionBox" Margin="0,6,0,12" Height="140" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" ToolTip="请描述你做了什么、看到什么、期望什么"/>
                    <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="联系方式（可选）"/>
                    <TextBox x:Name="ContactBox" Margin="0,6,0,0" ToolTip="邮箱 / QQ / 其他联系方式"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="添加截图" Padding="14,5" Click="OnAddScreenshot"/>
                        <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="截图"/>
                    </DockPanel>
                    <ListBox x:Name="ScreenshotList" Height="90" Margin="0,8,0,0" DisplayMemberPath="."/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="移除所选截图" Padding="12,5" Click="OnRemoveScreenshot"/>
                        <TextBlock Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Text="支持 PNG / JPG / BMP；上传前会重新编码为无损 PNG。"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <CheckBox x:Name="IncludeLogsBox" Content="提交日志（启动器日志 + 最近一次游戏 latest.log）" IsChecked="True"/>
                    <TextBlock Foreground="#64748B" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="日志只包含启动器/游戏排错所需文件，不会上传账号密码。"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="反馈服务器"/>
                    <TextBox x:Name="EndpointBox" Margin="0,6,0,0" ToolTip="反馈接收服务地址；一般用户不需要修改"/>
                    <TextBlock Foreground="#64748B" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="离线或服务器不可达时会自动进入待提交队列；联网且服务器在线后自动上传。"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="SubmitButton" Content="提交反馈" Width="130" Height="38" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="OnSubmit"/>
                <Button Content="关闭" Width="90" Height="38" Margin="10,0,0,0" Click="OnClose"/>
                <TextBlock x:Name="QueueText" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" Grid.Row="6" Foreground="#475569" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </Grid>
    </ScrollViewer>
</Window>
